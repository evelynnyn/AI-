{
  "openapi": "3.1.0",
  "info": {
    "title": "星語塔羅 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Me",
        "operationId": "read_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/readings": {
      "get": {
        "tags": [
          "readings"
        ],
        "summary": "List Readings",
        "operationId": "list_readings_api_v1_readings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Reading"
                  },
                  "type": "array",
                  "title": "Response List Readings Api V1 Readings Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "readings"
        ],
        "summary": "Create Reading",
        "operationId": "create_reading_api_v1_readings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reading"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/readings/{reading_id}": {
      "delete": {
        "tags": [
          "readings"
        ],
        "summary": "Delete Reading",
        "operationId": "delete_reading_api_v1_readings__reading_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "reading_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Reading Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DrawnCard": {
        "properties": {
          "position": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Position"
          },
          "card_id": {
            "type": "string",
            "pattern": "^(major-(0\\d|1\\d|2[01])|(wands|cups|swords|pentacles)-(0[1-9]|1[0-4]))$",
            "title": "Card Id"
          },
          "reversed": {
            "type": "boolean",
            "title": "Reversed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "position",
          "card_id"
        ],
        "title": "DrawnCard"
      },
      "FollowUp": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 5000,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "FollowUp"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "title": "Me"
      },
      "Reading": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "spread": {
            "type": "string",
            "enum": [
              "daily",
              "three_card"
            ],
            "title": "Spread"
          },
          "reader": {
            "type": "string",
            "enum": [
              "high_priestess",
              "magician",
              "fool"
            ],
            "title": "Reader"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/DrawnCard"
            },
            "type": "array",
            "title": "Cards"
          },
          "interpretation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interpretation"
          },
          "follow_ups": {
            "items": {
              "$ref": "#/components/schemas/FollowUp"
            },
            "type": "array",
            "title": "Follow Ups"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "question",
          "spread",
          "reader",
          "cards",
          "interpretation",
          "follow_ups",
          "created_at"
        ],
        "title": "Reading"
      },
      "ReadingCreate": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Question"
          },
          "spread": {
            "type": "string",
            "enum": [
              "daily",
              "three_card"
            ],
            "title": "Spread"
          },
          "reader": {
            "type": "string",
            "enum": [
              "high_priestess",
              "magician",
              "fool"
            ],
            "title": "Reader",
            "default": "high_priestess"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/DrawnCard"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Cards"
          },
          "interpretation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Interpretation"
          },
          "follow_ups": {
            "items": {
              "$ref": "#/components/schemas/FollowUp"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Follow Ups"
          }
        },
        "type": "object",
        "required": [
          "question",
          "spread",
          "cards"
        ],
        "title": "ReadingCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
