# Values from `supabase status` (local) or Project Settings > API (cloud).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
# Comma-separated frontend origins allowed by CORS. Never "*".
CORS_ORIGINS=http://localhost:3000

# AI reader. Keys live only on the server (SEC-03); never put them in frontend/.
# LLM_PROVIDER: anthropic (Claude), openai, groq, or mock (fake replies, no key, no cost)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b
GROQ_MODEL=
# low (default) keeps a reading inside Groq's free-tier limit; medium needs a paid plan
GROQ_REASONING_EFFORT=low
