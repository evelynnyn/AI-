# Values from `supabase status` (local) or Project Settings > API (cloud).
# Only the anon key belongs here. Never put the service_role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
